{
  "name": "linearctl",
  "version": "0.8.9",
  "private": true,
  "type": "module",
  "bin": {
    "linearctl": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "bun run embed:skills && tsc -p tsconfig.build.json && bun run copy:assets",
    "build:binary": "bun run embed:skills && bun build src/cli/main.ts --compile --outfile dist/linearctl",
    "embed:skills": "bun scripts/embed-skills.ts",
    "docs:update-readme-commands": "bun scripts/update-readme-command-table.ts",
    "copy:assets": "bun scripts/copy-assets.ts",
    "generate:api-manifest": "bun run src/generated/generate-manifest.ts",
    "regenerate:schema": "bun src/generated/regenerate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
